{
  "name": "@howells/hairline",
  "version": "0.1.0",
  "private": true,
  "description": "An engraved chart library for React: pixel-snapped hairlines, one ink hero per chart, and banknote textures.",
  "homepage": "https://hairline.danielhowells.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/howells/hairline.git"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./kit": {
      "types": "./lib/types/kit.d.ts",
      "default": "./lib/kit.js"
    },
    "./tokens.css": "./lib/tokens.css",
    "./theme.css": "./lib/theme.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p scripts",
    "lint": "howells-check .",
    "lint:fix": "howells-fix .",
    "build:lib": "node scripts/library-index.ts && howells-oxfmt src/index.ts src/kit.ts && vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/library-css.ts"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-chord": "^3.0.1",
    "d3-color": "^3.1.0",
    "d3-delaunay": "^6.0.4",
    "d3-force": "^3.0.0",
    "d3-format": "^3.1.2",
    "d3-geo": "^3.1.1",
    "d3-hierarchy": "^3.1.2",
    "d3-interpolate": "^3.0.1",
    "d3-polygon": "^3.0.1",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@howells/lint": "3.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-chord": "^3.0.6",
    "@types/d3-color": "^3.1.3",
    "@types/d3-delaunay": "^6.0.4",
    "@types/d3-force": "^3.0.10",
    "@types/d3-format": "^3.0.4",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-polygon": "^3.0.2",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-time": "^3.0.4",
    "@types/d3-time-format": "^4.0.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
