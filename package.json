{
  "name": "@howells/hairline",
  "version": "0.3.0",
  "description": "An engraved chart library for React: pixel-snapped hairlines, one ink hero per chart, and banknote textures.",
  "homepage": "https://hairline.danielhowells.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/howells/hairline.git"
  },
  "files": [
    "lib",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./draw": {
      "types": "./lib/types/draw.d.ts",
      "default": "./lib/draw.js"
    },
    "./frame": {
      "types": "./lib/types/frame.d.ts",
      "default": "./lib/frame.js"
    },
    "./kit": {
      "types": "./lib/types/kit.d.ts",
      "default": "./lib/kit.js"
    },
    "./schema": {
      "types": "./lib/types/schema.d.ts",
      "default": "./lib/schema.js"
    },
    "./theme": {
      "types": "./lib/types/theme.d.ts",
      "default": "./lib/theme.js"
    },
    "./json-schema/*": "./lib/json-schema/*",
    "./hairline.css": "./lib/hairline.css",
    "./tokens.css": "./lib/tokens.css",
    "./theme.css": "./lib/theme.css",
    "./maps": {
      "types": "./lib/types/maps.d.ts",
      "default": "./lib/maps.js"
    },
    "./dumbbell-queue": {
      "types": "./lib/types/entries/dumbbell-queue.d.ts",
      "default": "./lib/entries/dumbbell-queue.js"
    },
    "./hairline-area": {
      "types": "./lib/types/entries/hairline-area.d.ts",
      "default": "./lib/entries/hairline-area.js"
    },
    "./hairline-line": {
      "types": "./lib/types/entries/hairline-line.d.ts",
      "default": "./lib/entries/hairline-line.js"
    },
    "./plumb-scatter": {
      "types": "./lib/types/entries/plumb-scatter.d.ts",
      "default": "./lib/entries/plumb-scatter.js"
    },
    "./rung-bars": {
      "types": "./lib/types/entries/rung-bars.d.ts",
      "default": "./lib/entries/rung-bars.js"
    },
    "./slope": {
      "types": "./lib/types/entries/slope.d.ts",
      "default": "./lib/entries/slope.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pnpm build:docs",
    "build:docs": "pnpm --filter @howells/hairline-site build && rm -rf dist/docs && cp -R site/dist dist/docs",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p scripts && tsc -p acceptance && tsc -p site",
    "lint": "howells-check .",
    "lint:fix": "howells-fix .",
    "build:lib": "node scripts/library-index.ts && howells-oxfmt package.json src/index.ts src/kit.ts src/maps.ts src/schema.ts src/entries && vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/library-package.ts && node scripts/library-css.ts && node scripts/library-schema.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:lib && changeset publish",
    "test": "pnpm build:lib && tsc -p tests && vitest run",
    "e2e": "acceptance/docker.sh",
    "generate:baselines": "acceptance/docker.sh visual.spec.ts --update-snapshots",
    "generate:artefacts": "playwright test -c acceptance/artefacts.config.ts"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-chord": "^3.0.1",
    "d3-color": "^3.1.0",
    "d3-delaunay": "^6.0.4",
    "d3-force": "^3.0.0",
    "d3-format": "^3.1.2",
    "d3-geo": "^3.1.1",
    "d3-hierarchy": "^3.1.2",
    "d3-interpolate": "^3.0.1",
    "d3-polygon": "^3.0.1",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "topojson-client": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@howells/lint": "3.9.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-chord": "^3.0.6",
    "@types/d3-color": "^3.1.3",
    "@types/d3-delaunay": "^6.0.4",
    "@types/d3-force": "^3.0.10",
    "@types/d3-format": "^3.0.4",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-polygon": "^3.0.2",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-time": "^3.0.4",
    "@types/d3-time-format": "^4.0.3",
    "@types/geojson": "^7946.0.16",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "lightningcss": "^1.33.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "us-atlas": "^3.0.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "world-atlas": "^2.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "glob@<14.0.2": "14.0.2",
      "handlebars@<4.7.10": "4.7.10",
      "minimatch@<11.0.1": "11.0.1",
      "path-to-regexp@<6.3.0": "6.3.0",
      "postcss-selector-parser@<6.1.5": "6.1.5",
      "zod@<4.6.6": "4.6.7"
    }
  }
}
